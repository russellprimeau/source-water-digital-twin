# ---------------------------------------------------------------------------
# Delft3D FM model directories
#
# The model *configuration* is distributed so that the simulations reported in
# the manuscript can be reproduced with an independently obtained copy of the
# Delft3D FM kernel (see the Data Availability Statement).  Model *output* is
# not: it runs to tens of gigabytes.  MPI partition files, solver caches and
# run logs are regenerated by the solver and are excluded for the same reason.
#
# Only the governing run (ThermalTune) is distributed.  Rules re-include one
# directory level at a time because git cannot re-include a path whose parent
# directory is still excluded.
# ---------------------------------------------------------------------------
/data/d3d/*
!/data/d3d/ThermalTune/
/data/d3d/ThermalTune/*
!/data/d3d/ThermalTune/FlowFM2026/
/data/d3d/ThermalTune/FlowFM2026/*
!/data/d3d/ThermalTune/FlowFM2026/input/

# Within the distributed input set, exclude regenerable per-partition artifacts.
/data/d3d/ThermalTune/FlowFM2026/input/*_[0-9][0-9][0-9][0-9].mdu
/data/d3d/ThermalTune/FlowFM2026/input/*_[0-9][0-9][0-9][0-9]_net.nc
/data/d3d/ThermalTune/FlowFM2026/input/*.cache
/data/d3d/ThermalTune/FlowFM2026/input/*.dia
/data/d3d/ThermalTune/FlowFM2026/input/*.log

# ---------------------------------------------------------------------------
# Editor, OS and interpreter artifacts
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
Thumbs.db
~$*
.venv/
